# 10. Métricas agregadas no nível da grade

Agora avaliamos os 25 totais espaciais, e não cada linha risk-group-mês.

```{r metricas-grade}
# ============================================================
# 10. METRICAS NO NIVEL DA GRADE
# ============================================================

metricas_grade_modelo <- function(
    observado,
    previsto,
    nome
) {

  tibble::tibble(

    Modelo =
      nome,

    MAE_grade =
      mean(
        abs(
          observado -
            previsto
        )
      ),

    RMSE_grade =
      sqrt(

        mean(

          (
            observado -
              previsto
          )^2

        )

      ),

    Bias_grade =
      mean(
        previsto -
          observado
      ),

    Balance_total =
      sum(previsto) /
      sum(observado),

    Correlacao =
      cor(
        observado,
        previsto
      ),

    MAPE_grade =
      mean(

        abs(

          (
            previsto[
              observado > 0
            ] -
              observado[
                observado > 0
              ]
          ) /

            observado[
              observado > 0
            ]

        ),

        na.rm = TRUE

      ) *
      100

  )

}


metricas_grade <- dplyr::bind_rows(

  metricas_grade_modelo(

    por_grade$observado,
    por_grade$previsto_nb,
    "NB"

  ),

  metricas_grade_modelo(

    por_grade$observado,
    por_grade$previsto_rook,
    "SP-NB Rook"

  ),

  metricas_grade_modelo(

    por_grade$observado,
    por_grade$previsto_queen,
    "SP-NB Queen"

  )

)


knitr::kable(

  metricas_grade,

  digits = 4,

  caption =
    "Desempenho agregado no nível das 25 grades"

)
```

