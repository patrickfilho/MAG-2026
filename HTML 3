# 18. Métricas de comparação

```{r metric-functions}
# ============================================================
# 18. METRICAS
# ============================================================

metricas_modelo <- function(
    y,
    mu,
    phi,
    k,
    nome
) {


  ll <-
    loglik_nb(
      y,
      mu,
      phi
    )


  tibble::tibble(

    Modelo =
      nome,

    N =
      length(y),

    Observado =
      sum(y),

    Previsto =
      sum(mu),

    Balance =
      sum(mu) /
      sum(y),

    LogLik =
      ll,

    AIC =
      -2 *
      ll +
      2 *
      k,

    BIC =
      -2 *
      ll +
      log(
        length(y)
      ) *
      k,

    MAE =
      mean(
        abs(
          y -
            mu
        )
      ),

    RMSE =
      sqrt(

        mean(

          (
            y -
              mu
          )^2

        )

      ),

    LogScore =
      mean(

        dnbinom(

          y,

          mu =
            mu,

          size =
            phi,

          log =
            TRUE

        )

      )

  )

}
```

