# 5. Preparar as matrizes Rook e Queen

```{r matrizes}
# ============================================================
# 5. MATRIZES
# ============================================================

grids <- base %>%

  dplyr::distinct(
    id_celula,
    linha,
    coluna
  ) %>%

  dplyr::arrange(
    linha,
    coluna
  )


grid_order <-
  grids$id_celula


G <-
  nrow(grids)


A_rook <- matrix(
  0,
  G,
  G
)


A_queen <- matrix(
  0,
  G,
  G
)


for (i in seq_len(G)) {

  for (j in seq_len(G)) {

    if (i != j) {


      dl <-
        abs(
          grids$linha[i] -
            grids$linha[j]
        )


      dc <-
        abs(
          grids$coluna[i] -
            grids$coluna[j]
        )


      # ROOK

      if (
        dl + dc == 1
      ) {

        A_rook[i, j] <- 1

      }


      # QUEEN

      if (
        dl <= 1 &&
        dc <= 1
      ) {

        A_queen[i, j] <- 1

      }

    }

  }

}


rownames(A_rook) <- grid_order
colnames(A_rook) <- grid_order

rownames(A_queen) <- grid_order
colnames(A_queen) <- grid_order


cat(
  "Pares Rook:",
  sum(A_rook) / 2,
  "\n"
)

cat(
  "Pares Queen:",
  sum(A_queen) / 2,
  "\n"
)
```

# 6. Recalcular os spatial lags a partir de \(Y_{bar}\)

```{r spatial-lag}
# ============================================================
# 6. A * Y_BAR(t-1)
# ============================================================

calcular_spatial_lag <- function(
    dados,
    A,
    grid_order
) {


  resultado <- dados %>%

    dplyr::arrange(
      data_mes,
      match(
        id_celula,
        grid_order
      )
    )


  resultado$spatial_lag_estimacao <- 0


  meses <- sort(
    unique(
      resultado$data_mes
    )
  )


  for (tt in 2:length(meses)) {


    mes_anterior <-
      meses[
        tt - 1
      ]


    mes_atual <-
      meses[
        tt
      ]


    anterior <- resultado %>%

      dplyr::filter(
        data_mes ==
          mes_anterior
      )


    vetor_ybar <- rep(
      0,
      length(grid_order)
    )


    names(vetor_ybar) <-
      grid_order


    vetor_ybar[
      anterior$id_celula
    ] <-
      anterior$y_bar


    S <-
      as.numeric(
        A %*%
          vetor_ybar
      )


    names(S) <-
      grid_order


    idx <-
      which(
        resultado$data_mes ==
          mes_atual
      )


    resultado$spatial_lag_estimacao[
      idx
    ] <-

      S[
        resultado$id_celula[
          idx
        ]
      ]

  }


  resultado %>%

    dplyr::select(

      id_celula,
      ano,
      mes,

      spatial_lag_estimacao

    )

}


lag_rook <- calcular_spatial_lag(

  base,

  A_rook,

  grid_order

) %>%

  dplyr::rename(

    spatial_lag_rook_modelo =
      spatial_lag_estimacao

  )


lag_queen <- calcular_spatial_lag(

  base,

  A_queen,

  grid_order

) %>%

  dplyr::rename(

    spatial_lag_queen_modelo =
      spatial_lag_estimacao

  )


base <- base %>%

  dplyr::left_join(

    lag_rook,

    by =
      c(
        "id_celula",
        "ano",
        "mes"
      )

  ) %>%

  dplyr::left_join(

    lag_queen,

    by =
      c(
        "id_celula",
        "ano",
        "mes"
      )

  )
```

