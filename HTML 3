# 11. Funções do SP-NB

```{r funcoes}
# ============================================================
# 11. FUNCOES
# ============================================================

calcular_mu_spnb <- function(
    beta,
    gamma_psi,
    X,
    E,
    S,
    grid_idx
) {


  eta <-
    as.numeric(
      X %*%
        beta
    )


  taxa_base <-
    exp(
      pmin(
        eta,
        30
      )
    )


  psi <-
    exp(
      gamma_psi
    )


  taxa_spatial <-

    psi[
      grid_idx
    ] *
    S


  mu <-

    E *

    (
      taxa_base +
        taxa_spatial
    )


  pmax(
    mu,
    EPS
  )
}


loglik_nb <- function(
    y,
    mu,
    phi
) {


  sum(

    dnbinom(

      y,

      mu =
        mu,

      size =
        phi,

      log =
        TRUE

    )

  )

}
```

# 12. Algoritmo EM

```{r EM}
# ============================================================
# 12. EM
# ============================================================

fit_spnb_em <- function(
    y,
    X,
    E,
    S,
    grid_idx,
    n_grids,
    beta_init,
    phi_init,
    max_iter = 400,
    tol = 1e-6,
    verbose = TRUE
) {


  p <-
    ncol(X)


  beta <-
    beta_init


  phi <-
    max(
      phi_init,
      0.01
    )


  gamma_psi <- rep(

    log(
      1e-4
    ),

    n_grids

  )


  historico <-
    tibble::tibble()


  ll_anterior <-
    -Inf


  convergiu <-
    FALSE


  for (
    iter in seq_len(
      max_iter
    )
  ) {


    mu <-
      calcular_mu_spnb(

        beta =
          beta,

        gamma_psi =
          gamma_psi,

        X =
          X,

        E =
          E,

        S =
          S,

        grid_idx =
          grid_idx

      )


    # ========================================================
    # E-STEP
    # ========================================================

    w1 <-

      (
        phi +
          y
      ) /

      (
        phi +
          mu
      )


    w2 <-

      digamma(
        phi +
          y
      ) -

      log(
        phi +
          mu
      )


    # ========================================================
    # M-STEP: beta + psi
    # ========================================================

    objetivo_media <- function(
        par
    ) {


      beta_novo <-
        par[
          1:p
        ]


      gamma_novo <-
        par[
          (p + 1):
            length(par)
        ]


      mu_novo <-

        calcular_mu_spnb(

          beta =
            beta_novo,

          gamma_psi =
            gamma_novo,

          X =
            X,

          E =
            E,

          S =
            S,

          grid_idx =
            grid_idx

        )


      Q <-

        sum(

          y *
            log(
              mu_novo
            ) -

            w1 *
            mu_novo

        )


      -Q

    }


    parametros_atuais <-

      c(
        beta,
        gamma_psi
      )


    lower <-

      c(

        rep(
          -20,
          p
        ),

        rep(
          log(1e-10),
          n_grids
        )

      )


    upper <-

      c(

        rep(
          20,
          p
        ),

        rep(
          log(1),
          n_grids
        )

      )


    opt_media <-

      optim(

        par =
          parametros_atuais,

        fn =
          objetivo_media,

        method =
          "L-BFGS-B",

        lower =
          lower,

        upper =
          upper,

        control =
          list(
            maxit = 300
          )

      )


    beta <-

      opt_media$par[
        1:p
      ]


    gamma_psi <-

      opt_media$par[
        (p + 1):
          length(
            opt_media$par
          )
      ]


    # ========================================================
    # M-STEP: phi
    # ========================================================

    objetivo_phi <- function(
        log_phi
    ) {


      phi_novo <-
        exp(
          log_phi
        )


      Q_phi <-

        length(y) *

        (
          phi_novo *
            log(
              phi_novo
            ) -

            lgamma(
              phi_novo
            )
        ) +

        (
          phi_novo -
            1
        ) *
        sum(
          w2
        ) -

        phi_novo *
        sum(
          w1
        )


      -Q_phi

    }


    opt_phi <-

      optimize(

        objetivo_phi,

        interval =
          c(
            log(1e-4),
            log(1e5)
          )

      )


    phi <-
      exp(
        opt_phi$minimum
      )


    # ========================================================
    # Likelihood marginal
    # ========================================================

    mu <-

      calcular_mu_spnb(

        beta =
          beta,

        gamma_psi =
          gamma_psi,

        X =
          X,

        E =
          E,

        S =
          S,

        grid_idx =
          grid_idx

      )


    ll <-

      loglik_nb(
        y,
        mu,
        phi
      )


    delta_ll <-

      abs(
        ll -
          ll_anterior
      )


    historico <-

      dplyr::bind_rows(

        historico,

        tibble::tibble(

          iteracao =
            iter,

          logLik =
            ll,

          delta_logLik =
            delta_ll,

          phi =
            phi

        )

      )


    if (

      verbose &&
      (
        iter == 1 ||
        iter %% 10 == 0
      )

    ) {


      cat(

        "Iteracao",
        iter,

        "| logLik",
        round(
          ll,
          3
        ),

        "| delta",
        round(
          delta_ll,
          8
        ),

        "| phi",
        round(
          phi,
          4
        ),

        "\n"

      )

    }


    if (

      iter > 1 &&
      delta_ll <
        tol

    ) {


      convergiu <-
        TRUE

      break

    }


    ll_anterior <-
      ll

  }


  list(

    beta =
      beta,

    gamma_psi =
      gamma_psi,

    psi =
      exp(
        gamma_psi
      ),

    phi =
      phi,

    mu =
      mu,

    logLik =
      ll,

    historico =
      historico,

    iteracoes =
      iter,

    convergiu =
      convergiu

  )

}
```

