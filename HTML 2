# 5. Erros por grade

```{r erros-grade}
# ============================================================
# 5. ERROS
# ============================================================

por_grade <- por_grade %>%

  dplyr::mutate(

    # --------------------------------------------------------
    # Erro simples: previsto - observado
    # --------------------------------------------------------

    erro_nb =
      previsto_nb -
      observado,

    erro_rook =
      previsto_rook -
      observado,

    erro_queen =
      previsto_queen -
      observado,


    # --------------------------------------------------------
    # Erro absoluto
    # --------------------------------------------------------

    abs_erro_nb =
      abs(
        erro_nb
      ),

    abs_erro_rook =
      abs(
        erro_rook
      ),

    abs_erro_queen =
      abs(
        erro_queen
      ),


    # --------------------------------------------------------
    # Erro percentual
    #
    # NA quando observado = 0
    # --------------------------------------------------------

    erro_pct_nb =
      if_else(
        observado > 0,
        100 *
          erro_nb /
          observado,
        NA_real_
      ),

    erro_pct_rook =
      if_else(
        observado > 0,
        100 *
          erro_rook /
          observado,
        NA_real_
      ),

    erro_pct_queen =
      if_else(
        observado > 0,
        100 *
          erro_queen /
          observado,
        NA_real_
      ),


    # --------------------------------------------------------
    # Ratio previsto / observado
    #
    # 1 = perfeito em total agregado
    # --------------------------------------------------------

    ratio_nb =
      if_else(
        observado > 0,
        previsto_nb /
          observado,
        NA_real_
      ),

    ratio_rook =
      if_else(
        observado > 0,
        previsto_rook /
          observado,
        NA_real_
      ),

    ratio_queen =
      if_else(
        observado > 0,
        previsto_queen /
          observado,
        NA_real_
      )

  )
```

